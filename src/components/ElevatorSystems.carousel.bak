"use client";

import React, { useState, useEffect, useCallback, useRef } from "react";
import Image from "next/image";
import Link from "@/components/TransitionLink";
import { ArrowRight, ArrowLeft, Building, Building2, Stethoscope, Factory, Wrench } from "lucide-react";
import { motion } from "framer-motion";

interface ElevatorCardItem {
  id: string;
  title1: string;
  title2: string;
  image: string;
  icon: React.ComponentType<{ className?: string; strokeWidth?: number }>;
  href: string;
  step: string;
}

const BASE_CARDS: ElevatorCardItem[] = [
  {
    id: "residential",
    title1: "Residential",
    title2: "Elevators",
    image: "/images/3d_residential.jpg",
    icon: Building2,
    href: "/services/passenger-lifts",
    step: "01"
  },
  {
    id: "commercial",
    title1: "Commercial",
    title2: "Elevators",
    image: "/images/3d_commercial.jpg",
    icon: Building,
    href: "/services/passenger-lifts",
    step: "02"
  },
  {
    id: "hospital",
    title1: "Hospital",
    title2: "Elevators",
    image: "/images/3d_healthcare_v2.jpg",
    icon: Stethoscope,
    href: "/services/hospital-lifts",
    step: "03"
  },
  {
    id: "industrial",
    title1: "Industrial",
    title2: "Elevators",
    image: "/images/3d_industrial.jpg",
    icon: Factory,
    href: "/services/goods-lifts",
    step: "04"
  },
  {
    id: "modernization",
    title1: "Modernization",
    title2: "& AMC",
    image: "/hero-elevator.jpg",
    icon: Wrench,
    href: "/services",
    step: "05"
  }
];

export default function ElevatorSystems() {
  // Exactly ONE active card index (0 to 4)
  const [activeIndex, setActiveIndex] = useState(0);
  const [isHovered, setIsHovered] = useState(false);
  const [isMobile, setIsMobile] = useState(false);
  const [isTablet, setIsTablet] = useState(false);
  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleResize = () => {
      const width = window.innerWidth;
      setIsMobile(width < 768);
      setIsTablet(width >= 768 && width < 1200);
    };
    handleResize();
    window.addEventListener("resize", handleResize);

    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    // eslint-disable-next-line react-hooks/set-state-in-effect
    setPrefersReducedMotion(motionQuery.matches);
    const handleMotionChange = (e: MediaQueryListEvent) => setPrefersReducedMotion(e.matches);
    if (motionQuery.addEventListener) {
      motionQuery.addEventListener("change", handleMotionChange);
    }

    return () => {
      window.removeEventListener("resize", handleResize);
      if (motionQuery.removeEventListener) {
        motionQuery.removeEventListener("change", handleMotionChange);
      }
    };
  }, []);

  const nextCard = useCallback(() => {
    setActiveIndex(prev => (prev + 1) % BASE_CARDS.length);
  }, []);

  const prevCard = useCallback(() => {
    setActiveIndex(prev => (prev - 1 + BASE_CARDS.length) % BASE_CARDS.length);
  }, []);

  // Autoplay functionality with smooth pause on hover/interaction
  useEffect(() => {
    if (isHovered || prefersReducedMotion) return;
    const timer = setInterval(() => nextCard(), 6000);
    return () => clearInterval(timer);
  }, [isHovered, nextCard, prefersReducedMotion]);

  const handleKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        prevCard();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        nextCard();
      } else if (e.key === "Home") {
        e.preventDefault();
        setActiveIndex(0);
      } else if (e.key === "End") {
        e.preventDefault();
        setActiveIndex(BASE_CARDS.length - 1);
      }
    },
    [nextCard, prevCard]
  );

  const handleDragEnd = (_: unknown, info: { offset: { x: number } }) => {
    if (info.offset.x < -35) nextCard();
    else if (info.offset.x > 35) prevCard();
  };

  /**
   * 3D Radial / Orbital Geometry Variant
   * Strictly guarantees:
   * - EXACTLY ONE dominant hero card at diff === 0
   * - Symmetrically subordinated side cards at diff === ±1
   * - Peripheral background cards at diff === ±2
   */
  const getCardVariant = (diff: number) => {
    if (isMobile) {
      if (diff === 0) {
        return {
          x: 0,
          y: -5,
          z: 45,
          scale: 1.05,
          rotateY: 0,
          opacity: 1.0,
          zIndex: 50,
          filter: "brightness(1.05) contrast(1.02) blur(0px)",
        };
      } else if (diff === 1) {
        return {
          x: 145,
          y: 8,
          z: -45,
          scale: 0.86,
          rotateY: prefersReducedMotion ? 0 : -14,
          opacity: 0.75,
          zIndex: 30,
          filter: "brightness(0.90) contrast(0.95) blur(1.5px)",
        };
      } else if (diff === -1) {
        return {
          x: -145,
          y: 8,
          z: -45,
          scale: 0.86,
          rotateY: prefersReducedMotion ? 0 : 14,
          opacity: 0.75,
          zIndex: 30,
          filter: "brightness(0.90) contrast(0.95) blur(1.5px)",
        };
      } else {
        return {
          x: diff > 0 ? 240 : -240,
          y: 16,
          z: -100,
          scale: 0.72,
          rotateY: prefersReducedMotion ? 0 : (diff > 0 ? -22 : 22),
          opacity: 0,
          zIndex: 10,
          filter: "brightness(0.80) contrast(0.90) blur(3px)",
        };
      }
    }

    if (isTablet) {
      if (diff === 0) {
        return {
          x: 0,
          y: -10,
          z: 60,
          scale: 1.08,
          rotateY: 0,
          opacity: 1.0,
          zIndex: 50,
          filter: "brightness(1.05) contrast(1.03) blur(0px)",
        };
      } else if (diff === 1) {
        return {
          x: 185,
          y: 10,
          z: -40,
          scale: 0.88,
          rotateY: prefersReducedMotion ? 0 : -12,
          opacity: 0.85,
          zIndex: 35,
          filter: "brightness(0.85) contrast(0.95) blur(2px)",
        };
      } else if (diff === -1) {
        return {
          x: -185,
          y: 10,
          z: -40,
          scale: 0.88,
          rotateY: prefersReducedMotion ? 0 : 12,
          opacity: 0.85,
          zIndex: 35,
          filter: "brightness(0.85) contrast(0.95) blur(2px)",
        };
      } else if (diff === 2) {
        return {
          x: 330,
          y: 20,
          z: -100,
          scale: 0.76,
          rotateY: prefersReducedMotion ? 0 : -20,
          opacity: 0.60,
          zIndex: 20,
          filter: "brightness(0.75) contrast(0.90) blur(4px)",
        };
      } else if (diff === -2) {
        return {
          x: -330,
          y: 20,
          z: -100,
          scale: 0.76,
          rotateY: prefersReducedMotion ? 0 : 20,
          opacity: 0.60,
          zIndex: 20,
          filter: "brightness(0.75) contrast(0.90) blur(4px)",
        };
      }
    }

    // Desktop
    if (diff === 0) {
      return {
        x: 0,
        y: -12,
        z: 70,
        scale: 1.10,
        rotateY: 0,
        opacity: 1.0,
        zIndex: 50,
        filter: "brightness(1.05) contrast(1.03) blur(0px)",
      };
    } else if (diff === 1) {
      return {
        x: 235,
        y: 12,
        z: -40,
        scale: 0.90,
        rotateY: prefersReducedMotion ? 0 : -14,
        opacity: 0.85,
        zIndex: 35,
        filter: "brightness(0.85) contrast(0.95) blur(2.5px)",
      };
    } else if (diff === -1) {
      return {
        x: -235,
        y: 12,
        z: -40,
        scale: 0.90,
        rotateY: prefersReducedMotion ? 0 : 14,
        opacity: 0.85,
        zIndex: 35,
        filter: "brightness(0.85) contrast(0.95) blur(2.5px)",
      };
    } else if (diff === 2) {
      return {
        x: 420,
        y: 25,
        z: -120,
        scale: 0.78,
        rotateY: prefersReducedMotion ? 0 : -22,
        opacity: 0.60,
        zIndex: 20,
        filter: "brightness(0.70) contrast(0.90) blur(4.5px)",
      };
    } else if (diff === -2) {
      return {
        x: -420,
        y: 25,
        z: -120,
        scale: 0.78,
        rotateY: prefersReducedMotion ? 0 : 22,
        opacity: 0.60,
        zIndex: 20,
        filter: "brightness(0.70) contrast(0.90) blur(4.5px)",
      };
    }

    return {
      x: diff > 0 ? 550 : -550,
      y: 35,
      z: -180,
      scale: 0.65,
      rotateY: diff > 0 ? -30 : 30,
      opacity: 0,
      zIndex: 10,
      filter: "brightness(0.60) contrast(0.85) blur(6px)",
    };
  };

  return (
    <section 
      ref={containerRef}
      onKeyDown={handleKeyDown}
      tabIndex={0}
      aria-label="Elevator Solutions Radial Showcase"
      className="relative w-full overflow-hidden flex items-center select-none focus:outline-none 
                 bg-[#F7FAFD] text-[#0A2342] min-h-[620px] md:min-h-[580px] lg:min-h-[640px] py-12 md:py-14"
    >
      {/* 1. ARCHITECTURAL 3D LIGHTING ENVIRONMENT (LIGHT THEME) */}
      <div className="absolute inset-0 z-0 pointer-events-none overflow-hidden flex items-center justify-center">
        {/* Subtle Architectural Blueprint Perspective Grid */}
        <div 
          className="absolute inset-0 opacity-[0.22]"
          style={{
            backgroundImage: `
              linear-gradient(to right, #94A3B8 1px, transparent 1px),
              linear-gradient(to bottom, #94A3B8 1px, transparent 1px)
            `,
            backgroundSize: '48px 48px',
            transform: 'perspective(1000px) rotateX(62deg) scale(2.2) translateY(-6%)',
            transformOrigin: 'center center'
          }}
        />

        {/* Concentric Architectural Radar / Perspective Rings */}
        <div className="absolute top-1/2 left-[62%] -translate-x-1/2 -translate-y-1/2 w-[720px] h-[720px] rounded-full border border-[#0877F9]/10 pointer-events-none" />
        <div className="absolute top-1/2 left-[62%] -translate-x-1/2 -translate-y-1/2 w-[980px] h-[980px] rounded-full border border-[#0877F9]/5 pointer-events-none" />

        {/* Smooth Edge Fades */}
        <div className="absolute inset-0 bg-gradient-to-b from-[#F7FAFD] via-transparent to-[#F7FAFD] opacity-90" />
        <div className="absolute inset-0 bg-gradient-to-r from-[#F7FAFD] via-transparent to-[#F7FAFD] opacity-80" />
        
        {/* Soft architectural studio radial glow behind carousel */}
        <div className="absolute top-1/2 left-[62%] -translate-x-1/2 -translate-y-1/2 w-[55vw] max-w-[850px] h-[55vh] bg-[#0877F9] rounded-[100%] blur-[130px] opacity-[0.08]" />
        <div className="absolute top-1/2 left-[30%] -translate-x-1/2 -translate-y-1/2 w-[40vw] max-w-[600px] h-[40vh] bg-[#EAF1F8] rounded-[100%] blur-[100px] opacity-80" />
      </div>

      <div className="relative z-10 w-full site-container px-4 sm:px-6 lg:px-8 flex flex-col xl:flex-row items-center justify-between gap-8 xl:gap-6 h-full">
        
        {/* 2. LEFT: EDITORIAL COLUMN */}
        <div className="w-full xl:w-[28%] flex flex-col items-center xl:items-start text-center xl:text-left z-30 shrink-0 mt-1 xl:mt-0">
          <div className="text-[10px] md:text-[11px] font-bold tracking-[0.25em] text-[#0877F9] uppercase mb-3 flex items-center gap-3">
            <div className="w-8 h-px bg-[#0877F9] hidden xl:block"></div>
            INNOVATION IN EVERY RISE
          </div>

          <h2 className="text-[32px] sm:text-[36px] md:text-[40px] lg:text-[46px] font-bold leading-[1.06] tracking-tight mb-4">
            <span className="text-[#0A2342] block">ELEVATORS</span>
            <span className="text-[#0877F9] block">FOR EVERY SPACE</span>
          </h2>

          <p className="text-[#475569] text-[14px] md:text-[15px] lg:text-[15.5px] leading-[1.6] font-medium max-w-[380px] xl:max-w-[320px] mb-7">
            Safe. Reliable. Efficient. Customized solutions for residential, commercial, hospital and industrial projects.
          </p>

          <Link 
            href="/services" 
            className="inline-flex items-center justify-center gap-3 bg-[#0877F9] hover:bg-[#1FA9FF] text-white px-7 py-3 rounded-lg text-[14px] md:text-[15px] font-semibold transition-all shadow-[0_4px_20px_rgba(8,119,249,0.3)] active:scale-95 group"
          >
            <span>Explore Solutions</span>
            <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </Link>
        </div>

        {/* 3. RIGHT: 3D RADIAL CAROUSEL */}
        <div 
          className="w-full xl:w-[72%] relative flex flex-col items-center justify-center min-h-[460px] md:min-h-[500px]"
          onMouseEnter={() => setIsHovered(true)} 
          onMouseLeave={() => setIsHovered(false)}
          onTouchStart={() => setIsHovered(true)}
          onTouchEnd={() => setTimeout(() => setIsHovered(false), 2500)}
        >
          {/* Controls: Left Arrow */}
          <button 
            onClick={prevCard}
            aria-label="Previous elevator solution"
            className="absolute left-1 sm:left-2 md:left-4 lg:left-2 xl:left-4 top-[45%] -translate-y-1/2 z-50 w-10 h-10 md:w-11 md:h-11 rounded-full bg-white/95 backdrop-blur-md border border-[#CBD5E1] text-[#0A2342] flex items-center justify-center hover:bg-[#0877F9] hover:text-white hover:border-[#0877F9] transition-all shadow-[0_6px_20px_rgba(6,23,43,0.12)] active:scale-95 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0877F9]"
          >
            <ArrowLeft className="w-4 h-4 md:w-5 md:h-5 group-hover:-translate-x-0.5 transition-transform" strokeWidth={2} />
          </button>

          {/* Controls: Right Arrow */}
          <button 
            onClick={nextCard}
            aria-label="Next elevator solution"
            className="absolute right-1 sm:right-2 md:right-4 lg:right-2 xl:right-4 top-[45%] -translate-y-1/2 z-50 w-10 h-10 md:w-11 md:h-11 rounded-full bg-white/95 backdrop-blur-md border border-[#CBD5E1] text-[#0A2342] flex items-center justify-center hover:bg-[#0877F9] hover:text-white hover:border-[#0877F9] transition-all shadow-[0_6px_20px_rgba(6,23,43,0.12)] active:scale-95 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0877F9]"
          >
            <ArrowRight className="w-4 h-4 md:w-5 md:h-5 group-hover:translate-x-0.5 transition-transform" strokeWidth={2} />
          </button>

          {/* Carousel 3D Perspective Stage */}
          <div 
            className="relative w-full max-w-[940px] h-[410px] sm:h-[430px] md:h-[450px] lg:h-[480px] flex items-center justify-center" 
            style={{ perspective: "1600px" }}
          >
            
            {/* RADIAL 3D CARD ORBIT */}
            <div 
              className="relative w-full h-[360px] sm:h-[380px] md:h-[400px] lg:h-[440px] flex items-center justify-center z-20 pointer-events-auto" 
              style={{ transformStyle: "preserve-3d" }}
            >
              {BASE_CARDS.map((card, i) => {
                let diff = i - activeIndex;
                if (diff > 2) diff -= BASE_CARDS.length;
                if (diff < -2) diff += BASE_CARDS.length;

                const isActive = diff === 0;

                return (
                  <motion.div
                    key={card.id}
                    custom={diff}
                    initial={false}
                    animate={getCardVariant(diff)}
                    transition={{
                      duration: prefersReducedMotion ? 0.2 : 0.65,
                      ease: [0.22, 1, 0.36, 1]
                    }}
                    style={{ 
                      transformStyle: "preserve-3d", 
                      transformOrigin: "bottom center" 
                    }}
                    drag="x"
                    dragConstraints={{ left: 0, right: 0 }}
                    dragElastic={0.2}
                    onDragEnd={handleDragEnd}
                    onClick={() => setActiveIndex(i)}
                    className={`absolute bottom-0 left-1/2 -translate-x-1/2 
                                w-[195px] sm:w-[205px] md:w-[215px] lg:w-[235px]
                                h-[340px] sm:h-[360px] md:h-[385px] lg:h-[425px]
                                rounded-[20px] md:rounded-[22px] cursor-pointer`}
                  >
                    {/* Architectural Showcase Card Shell */}
                    <div 
                      className={`relative w-full h-full flex flex-col p-2 sm:p-2.5 rounded-[20px] md:rounded-[22px] overflow-hidden transition-all duration-500 ${
                        isActive 
                          ? "bg-white/80 backdrop-blur-2xl border border-white shadow-[0_30px_60px_-12px_rgba(8,119,249,0.25),0_0_40px_-10px_rgba(8,119,249,0.2)] ring-1 ring-[#0877F9]/30" 
                          : "bg-white/40 backdrop-blur-xl border border-white/50 shadow-[0_12px_36px_-6px_rgba(10,30,54,0.08)] hover:bg-white/50"
                      }`}
                    >
                      {/* Glass Inner Highlight / Edge Glow */}
                      <div 
                        className={`absolute inset-0 rounded-[20px] md:rounded-[22px] pointer-events-none transition-opacity duration-300 ${
                          isActive 
                            ? "shadow-[inset_0_1px_2px_rgba(255,255,255,1),inset_0_0_12px_rgba(255,255,255,0.5),inset_0_0_20px_rgba(8,119,249,0.15)]" 
                            : "shadow-[inset_0_1px_1px_rgba(255,255,255,0.7)]"
                        }`}
                      />

                      {/* Image Container: Taller Architectural Panel */}
                      <div className="relative w-full h-[78%] rounded-[14px] md:rounded-[16px] overflow-hidden bg-[#0A1E36]">
                        <Image
                          src={card.image}
                          alt={`${card.title1} ${card.title2}`}
                          fill
                          sizes="(max-width: 768px) 60vw, 240px"
                          className="object-cover transition-transform duration-700 ease-out"
                          style={{ 
                            transform: isActive ? "scale(1.02)" : "scale(1.0)",
                            opacity: isActive ? 1.0 : 0.85 
                          }}
                          priority={isActive}
                        />
                        
                        {/* Subtle cinematic gradient overlay for depth */}
                        <div className="absolute inset-0 bg-gradient-to-t from-[#06172B]/60 via-[#06172B]/10 to-transparent pointer-events-none" />
                      </div>

                      {/* Lower Information Area: Premium & Readable */}
                      <div className="relative flex items-center justify-between flex-1 w-full px-2 sm:px-3 pt-3 pb-1">
                        <div className="flex items-center gap-3 min-w-0">
                          <div 
                            className={`w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl transition-all shrink-0 ${
                              isActive
                                ? "bg-gradient-to-br from-[#0877F9] to-[#0556B8] text-white shadow-[0_4px_12px_rgba(8,119,249,0.4)] border border-white/20"
                                : "bg-white/60 text-[#475569] border border-white/80 shadow-sm"
                            }`}
                          >
                            <card.icon className="w-4 h-4 sm:w-5 sm:h-5" strokeWidth={2} />
                          </div>
                          <div className="flex flex-col min-w-0">
                            <span 
                              className={`font-bold text-[15px] sm:text-[16px] md:text-[17px] leading-[1.15] truncate transition-colors ${
                                isActive ? "text-[#0A2342]" : "text-[#1E293B]"
                              }`}
                            >
                              {card.title1}
                            </span>
                            <span 
                              className={`font-medium text-[12px] sm:text-[13px] md:text-[14px] leading-[1.15] truncate transition-colors ${
                                isActive ? "text-[#0877F9]" : "text-[#64748B]"
                              }`}
                            >
                              {card.title2}
                            </span>
                          </div>
                        </div>
                      </div>

                      {/* Top Glass Highlight Overlay */}
                      {isActive && (
                        <div className="absolute top-0 left-0 right-0 h-[40%] bg-gradient-to-b from-white/30 to-transparent pointer-events-none z-30 rounded-t-[20px] md:rounded-t-[22px]" />
                      )}
                    </div>
                  </motion.div>
                );
              })}
            </div>
          </div>

          {/* 4. PAGINATION DOTS (Centered under platform) */}
          <div 
            className="absolute bottom-[-8px] md:bottom-1 left-1/2 -translate-x-1/2 flex items-center justify-center gap-2.5 z-30" 
            role="tablist"
            aria-label="Elevator solutions slides"
          >
            {BASE_CARDS.map((card, i) => {
              const isSelected = i === activeIndex;
              return (
                <button
                  key={card.id}
                  role="tab"
                  aria-selected={isSelected}
                  aria-label={`Go to ${card.title1} ${card.title2}`}
                  onClick={() => setActiveIndex(i)}
                  className={`transition-all duration-300 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0877F9] ${
                    isSelected
                      ? "w-8 h-2.5 bg-[#0877F9] shadow-[0_0_10px_rgba(8,119,249,0.5)] rounded-full"
                      : "w-2.5 h-2.5 bg-[#CBD5E1] hover:bg-[#94A3B8]"
                  }`}
                />
              );
            })}
          </div>
        </div>
      </div>
    </section>
  );
}
