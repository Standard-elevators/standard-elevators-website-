"use client";

import React, { useState } from "react";
import Image from "next/image";
import { Building2, Cog, MapPin, ShieldCheck, Wrench } from "lucide-react";

interface Credential {
  id: string;
  icon: React.ReactNode;
  value: string;
  labelTop: string;
  labelBottom: string;
}

const CREDENTIALS: Credential[] = [
  {
    id: "est-2003",
    icon: <Building2 style={{ width: '22px', height: '22px', color: '#0877F9', strokeWidth: 1.5 }} />,
    value: "2003",
    labelTop: "ESTABLISHED",
    labelBottom: "IN HYDERABAD",
  },
  {
    id: "installs-100",
    icon: <Cog style={{ width: '22px', height: '22px', color: '#0877F9', strokeWidth: 1.5 }} />,
    value: "100+",
    labelTop: "VERIFIED",
    labelBottom: "INSTALLATIONS",
  },
  {
    id: "coverage-ts-ap",
    icon: <MapPin style={{ width: '22px', height: '22px', color: '#0877F9', strokeWidth: 1.5 }} />,
    value: "TS & AP",
    labelTop: "STATEWIDE",
    labelBottom: "COVERAGE",
  },
  {
    id: "safety-bis",
    icon: <ShieldCheck style={{ width: '22px', height: '22px', color: '#0877F9', strokeWidth: 1.5 }} />,
    value: "BIS",
    labelTop: "SAFETY",
    labelBottom: "STANDARDS",
  },
];

const CAPABILITIES = [
  {
    id: "custom-installation",
    icon: <Wrench style={{ width: '24px', height: '24px', color: '#F59A2A', strokeWidth: 1.5 }} />,
    title: "Custom Installation",
    description:
      "Tailored elevator systems integrated seamlessly into your building's architectural specifications, whether for commercial or residential spaces.",
  },
  {
    id: "modernization",
    icon: <Cog style={{ width: '24px', height: '24px', color: '#F59A2A', strokeWidth: 1.5 }} />,
    title: "Modernization",
    description:
      "Upgrading existing infrastructure with contemporary gearless technology, smart control panels, and improved safety features.",
  },
  {
    id: "programmed-maintenance",
    icon: <ShieldCheck style={{ width: '24px', height: '24px', color: '#F59A2A', strokeWidth: 1.5 }} />,
    title: "Programmed Maintenance",
    description:
      "Scientific maintenance schedules ensuring long-term reliability, maximum uptime, and strict adherence to safety standards.",
  },
];

export default function EngineeringCredentials() {
  const [hoveredCard, setHoveredCard] = useState<string | null>(null);

  return (
    <section
      id="engineering-credentials"
      style={{
        position: 'relative',
        width: '100%',
        backgroundColor: '#050B14', // Deep Navy Blue base
        color: '#ffffff',
        overflow: 'hidden',
        userSelect: 'none',
        fontFamily: 'var(--font-inter), sans-serif',
      }}
    >
      {/* ========================================================================= */}
      {/* 3D MESH WIREFRAME BACKGROUND (Pure CSS)                                   */}
      {/* ========================================================================= */}
      <div style={{ position: 'absolute', inset: 0, pointerEvents: 'none', zIndex: 0, overflow: 'hidden' }}>
        
        {/* Base 3D Perspective Grid - Electric Blue (Static, rock-solid CAD blueprint wireframe) */}
        <div style={{
          position: 'absolute',
          top: '-50%',
          left: '-50%',
          right: '-50%',
          bottom: '-50%',
          backgroundImage: `
            linear-gradient(rgba(10, 120, 245, 0.18) 1px, transparent 1px),
            linear-gradient(90deg, rgba(10, 120, 245, 0.18) 1px, transparent 1px)
          `,
          backgroundSize: '44px 44px',
          transform: 'perspective(1000px) rotateX(60deg) rotateZ(-30deg) translateY(-15%)',
          transformOrigin: 'center center',
        }} />
        
        {/* Secondary 3D Grid - Golden Accent */}
        <div style={{
          position: 'absolute',
          top: '-50%',
          left: '-50%',
          right: '-50%',
          bottom: '-50%',
          backgroundImage: `
            linear-gradient(rgba(245, 154, 42, 0.12) 1px, transparent 1px),
            linear-gradient(90deg, rgba(245, 154, 42, 0.12) 1px, transparent 1px)
          `,
          backgroundSize: '66px 66px',
          transform: 'perspective(1200px) rotateX(70deg) rotateZ(45deg) translateY(10%)',
          transformOrigin: 'center center',
        }} />

        {/* Dynamic Light Orbs to highlight the mesh */}
        <div style={{
          position: 'absolute',
          top: '20%',
          left: '30%',
          width: '50vw',
          height: '50vw',
          background: 'radial-gradient(circle, rgba(10,120,245,0.15) 0%, transparent 70%)',
          transform: 'translate(-50%, -50%)',
        }} />
        
        <div style={{
          position: 'absolute',
          bottom: '10%',
          right: '10%',
          width: '40vw',
          height: '40vw',
          background: 'radial-gradient(circle, rgba(245,154,42,0.1) 0%, transparent 60%)',
          transform: 'translate(50%, 50%)',
        }} />

        {/* Soft radial fade out to blend edges smoothly into the #050B14 background */}
        <div style={{
          position: 'absolute',
          inset: 0,
          background: 'radial-gradient(circle at center, transparent 30%, #050B14 90%)'
        }} />
      </div>

      {/* ========================================================================= */}
      {/* MAIN CONTENT CONTAINER                                                    */}
      {/* ========================================================================= */}
      <div style={{
        position: 'relative',
        zIndex: 10,
        width: 'min(1320px, calc(100% - 48px))',
        maxWidth: '1320px',
        margin: '0 auto',
        padding: '90px 0',
        display: 'flex',
        flexDirection: 'column',
        gap: '70px',
      }}>
        
        {/* ------------------------------------------------------------------------- */}
        {/* TOP SECTION: Typography & 4 Horizontal Cards                              */}
        {/* ------------------------------------------------------------------------- */}
        <div style={{ position: 'relative', display: 'flex', flexDirection: 'column', gap: '60px' }}>

          {/* HEADER TYPOGRAPHY */}
          <div style={{ maxWidth: '680px', position: 'relative', zIndex: 10 }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '16px', marginBottom: '20px' }}>
              <span style={{ 
                fontSize: '11px', 
                fontWeight: 700, 
                letterSpacing: '0.25em', 
                color: '#F59A2A', 
                textTransform: 'uppercase',
              }}>
                Engineering Credentials
              </span>
              <div style={{ height: '2px', width: '40px', backgroundColor: '#F59A2A', boxShadow: '0 0 10px rgba(245,154,42,0.8)' }} />
            </div>

            <h2 style={{ 
              fontSize: 'clamp(36px, 4.2vw, 52px)', 
              lineHeight: 1.08, 
              fontWeight: 800, 
              color: '#ffffff',
              letterSpacing: '-0.02em', 
              marginBottom: '24px',
            }}>
              Delivering <br />
              <span style={{ color: '#F59A2A' }}>
                precision
              </span> <br />
              vertical mobility
            </h2>

            <p style={{ 
              fontSize: 'clamp(16px, 1.8vw, 18px)', 
              lineHeight: 1.6, 
              color: '#D1D5DB', 
              fontWeight: 400, 
              maxWidth: '500px',
            }}>
              Through custom design, advanced manufacturing, and rigorous maintenance protocols since 2003.
            </p>
          </div>

          {/* 4 CREDENTIAL CARDS */}
          <div style={{ position: 'relative', zIndex: 10 }}>
            <div style={{
              display: 'flex',
              flexWrap: 'wrap',
              gap: '24px',
              alignItems: 'center',
            }}>
              {CREDENTIALS.map((cred) => (
                <div key={cred.id} style={{
                  width: '155px',
                  height: '180px',
                  background: 'linear-gradient(135deg, rgba(16, 36, 61, 0.8) 0%, rgba(10, 20, 35, 0.9) 100%)',
                  backdropFilter: 'blur(24px)',
                  WebkitBackdropFilter: 'blur(24px)',
                  border: '1px solid rgba(255, 255, 255, 0.1)',
                  borderTop: '2px solid rgba(245,154,42,0.4)',
                  borderRadius: '20px',
                  padding: '24px 16px',
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  boxShadow: '0 12px 36px rgba(0, 0, 0, 0.3), inset 0 2px 4px rgba(255,255,255,0.05)',
                  transition: 'all 0.4s ease',
                  cursor: 'default',
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.transform = 'translateY(-6px)';
                  e.currentTarget.style.boxShadow = '0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(245,154,42,0.2)';
                  e.currentTarget.style.borderTop = '2px solid rgba(245,154,42,0.8)';
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.transform = 'translateY(0)';
                  e.currentTarget.style.boxShadow = '0 12px 36px rgba(0, 0, 0, 0.3), inset 0 2px 4px rgba(255,255,255,0.05)';
                  e.currentTarget.style.borderTop = '2px solid rgba(245,154,42,0.4)';
                }}
                >
                  <div style={{
                    width: '46px',
                    height: '46px',
                    borderRadius: '50%',
                    background: 'rgba(255,255,255,0.05)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    border: '1px solid rgba(245,154,42,0.2)',
                    boxShadow: '0 4px 12px rgba(245, 154, 42, 0.15)'
                  }}>
                    {React.cloneElement(cred.icon as React.ReactElement<{ color?: string }>, { color: '#F59A2A' })}
                  </div>

                  <div style={{ 
                    fontSize: '32px', 
                    fontWeight: 800, 
                    color: '#ffffff', 
                    letterSpacing: '-0.02em', 
                    marginTop: '16px', 
                    marginBottom: '8px', 
                    lineHeight: 1 
                  }}>
                    {cred.value}
                  </div>

                  <div style={{ 
                    fontSize: '10px', 
                    fontWeight: 700, 
                    color: '#9CA3AF', 
                    textTransform: 'uppercase', 
                    letterSpacing: '0.15em', 
                    textAlign: 'center', 
                    lineHeight: 1.5 
                  }}>
                    <div>{cred.labelTop}</div>
                    <div style={{ color: '#F59A2A' }}>{cred.labelBottom}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* ------------------------------------------------------------------------- */}
        {/* BOTTOM SECTION: 3 Services Cards                                          */}
        {/* ------------------------------------------------------------------------- */}
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(320px, 1fr))',
          gap: '32px',
          maxWidth: '1200px',
        }}>
          {CAPABILITIES.map((cap, idx) => {
            const bgImage = idx === 0 ? '/images/card_installation.jpg' : idx === 1 ? '/images/card_modernization.jpg' : '/images/card_maintenance.jpg';
            const isHovered = hoveredCard === cap.id;
            
            return (
            <div 
              key={cap.id} 
              onMouseEnter={() => setHoveredCard(cap.id)}
              onMouseLeave={() => setHoveredCard(null)}
              style={{
                position: 'relative',
                borderRadius: '24px',
                height: '400px',
                display: 'flex',
                flexDirection: 'column',
                justifyContent: 'flex-end',
                boxShadow: isHovered ? '0 25px 50px rgba(0,0,0,0.8), 0 0 30px rgba(245,154,42,0.2)' : '0 15px 30px rgba(0,0,0,0.6)',
                transform: isHovered ? 'translateY(-8px)' : 'translateY(0)',
                transition: 'all 0.4s ease',
                overflow: 'hidden',
                border: '1px solid rgba(255,255,255,0.1)',
            }}
            >
              {/* Dynamic Image Background */}
              <div style={{ position: 'absolute', inset: 0, zIndex: 0 }}>
                <Image
                  src={bgImage}
                  alt={cap.title}
                  fill
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                  style={{
                    objectFit: 'cover',
                    transform: isHovered ? 'scale(1.1)' : 'scale(1.0)',
                    transition: 'transform 0.7s ease',
                  }}
                />
                {/* Gradient Overlay so text is readable */}
                <div style={{ 
                  position: 'absolute', 
                  inset: 0, 
                  background: 'linear-gradient(to top, rgba(5,10,18,0.95) 0%, rgba(5,10,18,0.7) 40%, rgba(5,10,18,0.2) 100%)',
                  transition: 'background 0.5s ease',
                }}></div>
              </div>

              {/* Icon housed in a soft architectural square */}
              <div style={{ 
                position: 'absolute',
                top: '32px',
                left: '32px',
                width: '56px',
                height: '56px',
                borderRadius: '16px',
                background: 'rgba(20,25,35,0.6)',
                backdropFilter: 'blur(12px)',
                border: '1px solid rgba(245,154,42,0.4)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                transition: 'transform 0.3s ease',
                transform: isHovered ? 'scale(1.1)' : 'scale(1)',
                zIndex: 10,
              }}>
                {React.cloneElement(cap.icon as React.ReactElement<{ color?: string }>, { color: '#F59A2A' })}
              </div>

              {/* Text Content */}
              <div style={{ position: 'relative', zIndex: 10, padding: '40px 32px' }}>
                <h3 style={{ 
                  fontSize: '24px', 
                  fontWeight: 800, 
                  color: '#ffffff', 
                  marginBottom: '12px', 
                  letterSpacing: '0.02em',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  textTransform: 'uppercase',
                }}>
                  {cap.title}
                </h3>
                
                <p style={{ 
                  fontSize: '15px', 
                  lineHeight: 1.6, 
                  color: 'rgba(255,255,255,0.7)', 
                  fontWeight: 400, 
                  margin: 0,
                  transition: 'color 0.3s ease',
                }}>
                  {cap.description}
                </p>
              </div>
            </div>
          )})}
        </div>

      </div>
    </section>
  );
}
