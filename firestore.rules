rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if requesting user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Explicit Admin Check:
    function isAuthorizedAdmin() {
      return isAuthenticated();
    }

    // Admins Allowlist
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Services Collection:
    // Public visitors can read services; authenticated admins can create, update, delete
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Gallery Collection:
    // Public visitors can read gallery items; authenticated admins can create, update, delete
    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Settings Collection (services_page, site_settings, etc.):
    // Public visitors can read settings; authenticated admins can update
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Customer Inquiries & Quotes:
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAuthenticated();
    }

    match /contacts/{contactId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
